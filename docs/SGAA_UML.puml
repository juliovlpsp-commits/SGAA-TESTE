@startuml SGAA
' SGAA - Sistema de Gestao Academica com Excecoes
' Render at https://plantuml.com/plantuml or export to png
left to right direction
skinparam backgroundColor #121212
skinparam shadowing false
skinparam ArrowColor #BBBBBB
skinparam ClassBackgroundColor #1E1E1E
skinparam ClassBorderColor #3A3A3A
skinparam ClassFontColor #E0E0E0
skinparam ClassAttributeFontColor #E0E0E0
skinparam ClassStereotypeFontColor #90CAF9
skinparam ClassHeaderBackgroundColor #252525
skinparam NoteBackgroundColor #2C2C2C
skinparam NoteBorderColor #444444
skinparam NoteFontColor #E0E0E0
skinparam PackageBackgroundColor #1E1E1E
skinparam PackageBorderColor #3A3A3A
skinparam PackageFontColor #E0E0E0
skinparam classAttributeIconSize 0

class ControleSono {
  - horasSono : int
  - semanas : int
  + ControleSono()
  + defineHorasSono(valor: int) : void
  + defineSemanas(valor: int) : void
  + getStatus() : String
}

class RegistroEstudo {
  - nome : String
  - meta : int
  - horas : int
  + RegistroEstudo(nome: String)
  + RegistroEstudo(nome: String, meta: int)
  + adicionaHoras(valor: int) : void
  + atingiuMeta() : boolean
  + toString() : String
}

class Componente {
  - nome : String
  - horas : int
  - notas : double[]
  - pesos : int[]
  + Componente(nome: String)
  + Componente(nome: String, qtdNotas: int)
  + Componente(nome: String, qtdNotas: int, pesos: int[])
  + registraHoras(h: int) : void
  + registraNota(num: int, valor: double) : void
  - calculaMedia() : double
  + aprovado() : boolean
  + toString() : String
}

class Anotacao {
  - tema : String
  - conteudo : String
  + Anotacao(tema: String, conteudo: String)
  + getTema() : String
  + getConteudo() : String
  + toString() : String
}

class BlocoAnotacoes {
  - bloco : Anotacao[]
  - qtd : int
  - pos : int
  + BlocoAnotacoes(capacidade: int)
  + adiciona(tema: String, conteudo: String) : void
  + adicionaAnotacao(tema: String, conteudo: String) : void
  + pegaAnotacoes() : String[]
  + conta() : int
  + contaAnotacoes() : int
  + imprimeAnotacoes() : String
  + temAnotacao(tema: String) : boolean
  + busca(chave: String) : String[]
  - posReal(pos: int) : int
}

class SGAA {
  + main(args: String[]) : void
}

class HorasInvalidasException {
  + HorasInvalidasException(msg: String)
}

class AnotacaoExistenteException {
  + AnotacaoExistenteException(msg: String)
}

HorasInvalidasException --|> IllegalArgumentException
AnotacaoExistenteException --|> RuntimeException

BlocoAnotacoes "1" *-- "0..*" Anotacao : contem >
SGAA ..> ControleSono : usa
SGAA ..> RegistroEstudo : usa
SGAA ..> Componente : usa
SGAA ..> BlocoAnotacoes : usa
ControleSono ..> HorasInvalidasException : lanca
RegistroEstudo ..> HorasInvalidasException : lanca
Componente ..> HorasInvalidasException : lanca
BlocoAnotacoes ..> AnotacaoExistenteException : lanca

note right of BlocoAnotacoes
  Buffer circular: ao encher
  sobrescreve o mais antigo.
  Tema duplicado lanca
  AnotacaoExistenteException.
  busca() case-insensitive
  e retorna ordenado.
end note

note right of Componente
  Media ponderada se
  pesos != null
  senao media aritmetica
end note
@enduml
